{
  "name": "ai-office",
  "version": "0.2.0",
  "description": "Escritório em pixel art para gerenciar várias sessões do Claude Code",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite",
    "app": "tsx server/launch.ts",
    "test": "vite build --logLevel warn && vitest run --reporter=verbose",
    "test:watch": "vitest",
    "service:install": "tsx server/service.ts install",
    "service:uninstall": "tsx server/service.ts uninstall",
    "service:status": "tsx server/service.ts status",
    "memoria:up": "tsx server/memory-cli.ts up",
    "memoria:down": "tsx server/memory-cli.ts down",
    "memoria:status": "tsx server/memory-cli.ts status"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "fastify": "^5.12.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
